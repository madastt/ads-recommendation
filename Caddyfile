{
    default_sni 192.168.0.13
}

localhost, 192.168.0.13 {
    tls internal

    handle /api/* {
        reverse_proxy api:8080
    }
    handle /swagger/* {
        reverse_proxy api:8080
    }
    handle /uploads/* {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy frontend:5173 {
            header_up Host localhost
        }
    }
}